{
  "rust-analyzer.check.command": "clippy",
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/testdata/**": true
  },
  "search.exclude": {
    "**/target": true,
    "**/*.grf": true,
    "**/Cargo.lock": false
  },
  "files.associations": {
    "*.lub": "lua"
  }
}
